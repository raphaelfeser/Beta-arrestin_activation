O6205: COORDINATION GROUPA=6205 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.3 NN=6 MM=10 D_MAX=1.0} NLIST NL_CUTOFF=1.5 NL_STRIDE=20

# --- Beta strand 1 --- (centers of heavy sidechain atoms) +2
beta1_grp: GROUP ATOMS=SC6,SC7,SC8,SC9,SC10,SC11,SC12

# --- Beta strand 20 --- (centers of heavy sidechain atoms) +2 +2
beta20_grp: GROUP ATOMS=SC384,SC385,SC386,SC387,SC388,SC389,SC390,SC391,SC392

# --- Other beta strands (1–19) --- (C-alpha atoms only)
beta_1_19_ca: GROUP ATOMS=70,84,108,124,144,166,188,266,285,299,315,336,408,420,440,456,565,577,593,605,612,628,644,663,821,845,861,882,898,912,931,945,956,966,986,1010,1195,1215,1239,1261,1273,1292,1312,1328,1338,1352,1368,1385,1396,1825,1835,1858,1870,1890,1904,1924,2055,2071,2085,2104,2236,2247,2254,2270,2282,2303,2318,2334,2356,2366,2386,2405,2611,2622,2638,2662,2681,2697,2716,2740,2762,2778,2969,2984,2998,3012,3036,3168,3187,3204,3223,3238,3248,3259,3327,3346,3367,3441,3460,3471,3487,3501,3517,3534,3550,3564,3656,3672,3694,3716,3735,3757,3776,3787,3803,3827,3844,3865,3875,3887,3999,4016,4037,4059,4077,4089,4105,4115,4132,4147,4162,4261,4272,4286,4306,4317,4339,4355,4376,4390,4606,4625,4635,5065,5084,5103,5119,5130,5151,5173,5189,5211,5227,5249,5268,5284,5446,5457,5469,5485,5495,5511,5526,5547,5559,5579,5593,5612

# --- C-tail and Gate Loop --- (C-alpha atoms only) 
Ctail_ca_grp: GROUP ATOMS=6220,6240,6250,6274,6291,6315
GateLoop_ca_grp: GROUP ATOMS=4654,4666,4673,4695,4714,4736,4753,4768,4780,4794,4808


# --- CENTER ATOMS
beta1CTR: CENTER ATOMS=beta1_grp
beta20CTR: CENTER ATOMS=beta20_grp
beta_1_19_caCTR: CENTER ATOMS=beta_1_19_ca

CtailCTR: CENTER ATOMS=Ctail_ca_grp
GateLoopCTR: CENTER ATOMS=GateLoop_ca_grp


# --- CVs DEFINITION
# --- CV1: number of contacts between beta1 and beta20 ---
c1_20: COORDINATION GROUPA=beta1_grp GROUPB=beta20_grp SWITCH={RATIONAL R_0=0.40 NN=6 MM=12} #NLIST=nl

# --- CV2: number of contacts between beta20 and all other beta strands (1–19) --- 
c20_others: COORDINATION GROUPA=beta20_grp GROUPB=beta_1_19_ca SWITCH={RATIONAL R_0=0.45 NN=6 MM=12} #NLIST=nl

# --- CV3: distance between C-terminus and gate loop --- 
d_ct_gl_dist: DISTANCE ATOMS=CtailCTR,GateLoopCTR

# --- CV4: distance between beta20 and all other beta strands (1–19) ---
d_20_others_dist: DISTANCE ATOMS=beta20CTR,beta_1_19_caCTR

# --- Attempt of cylidric constraint ---
lig: CENTER ATOMS=6114,6126,6138,6157,6173,6193,6208,6220,6240
p0: CENTER ATOMS=1181,1195,1215,1239,1261
p1: CENTER ATOMS=108,124,144,166,188
pp: PROJECTION_ON_AXIS AXIS_ATOMS=p0,p1 ATOM=lig

uwall: UPPER_WALLS ARG=pp.ext AT=1.5 KAPPA=5000 EXP=2 EPS=1 OFFSET=0

r: RMSD REFERENCE=../npt_300_elongated_soloCA_beta_1_19.pdb TYPE=OPTIMAL
uwall_rmsd: UPPER_WALLS ARG=r AT=0.05 KAPPA=50000 EXP=2 EPS=1 OFFSET=0

lwall_d_20_others_dist: LOWER_WALLS ARG=d_20_others_dist AT=2.5 KAPPA=5000 EXP=2 EPS=1 OFFSET=0
uwall_proj: UPPER_WALLS ARG=pp.proj AT=5.5 KAPPA=5000 EXP=2 EPS=1 OFFSET=0

fSC_proj: CUSTOM ARG=cmap_compact_test,pp.proj FUNC=y-4.168+0.1143*x PERIODIC=NO
lwallfSC_proj: LOWER_WALLS ARG=fSC_proj AT=0.0 KAPPA=500.0 EXP=2 EPS=1 OFFSET=0

fHB_proj: CUSTOM ARG=diffHB_compact_test,pp.proj FUNC=y-2.914+0.08937*x PERIODIC=NO
lwallfHB_proj: LOWER_WALLS ARG=fHB_proj AT=0.0 KAPPA=500.0 EXP=2 EPS=1 OFFSET=0

# Hydration CVs
hyd8: COORDINATION GROUPA=121 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.35 NN=6 MM=10 D_MAX=1.20} NLIST NL_CUTOFF=1.6 NL_STRIDE=20
hyd9: COORDINATION GROUPA=141 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.35 NN=6 MM=10 D_MAX=1.20} NLIST NL_CUTOFF=1.6 NL_STRIDE=20
hyd10: COORDINATION GROUPA=162 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.35 NN=6 MM=10 D_MAX=1.20} NLIST NL_CUTOFF=1.6 NL_STRIDE=20
hyd11: COORDINATION GROUPA=185 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.35 NN=6 MM=10 D_MAX=1.20} NLIST NL_CUTOFF=1.6 NL_STRIDE=20
hyd12: COORDINATION GROUPA=194 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.35 NN=6 MM=10 D_MAX=1.20} NLIST NL_CUTOFF=1.6 NL_STRIDE=20

